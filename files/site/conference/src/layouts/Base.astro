---
/**
 * All the chrome: fonts, the whole stylesheet, the header from the event's navigation and the
 * footer from the event — nothing else knows this much of the design. The pages pass the event
 * down and stay focused on their own body.
 *
 * One deliberate extension of the demo CSS: the filter bar also styles `a` alongside `button`,
 * because the session filters are links that carry URL params, not forms.
 */
import { formatDateRange } from '../trokky/site'
interface Props { title?: string; description?: string; event: Record<string, any> | null }
const { title, description, event } = Astro.props
const ev = event
const siteName = ev?.name ?? 'Conference'
const nav: { label: string; href: string }[] = ev?.navigation ?? []
// Active link: the current path under the nav href (/speakers/speaker-01 sits under /speakers).
const current = Astro.url.pathname
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${siteName}` : siteName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global>
      /* ==========================================================================
       * The conference design: serif display, grotesk body, off-white ground,
       * ink type, one editorial-red accent. Ported from the framework-live demo
       * template; the only change is Söhne's removal (a commercial font) —
       * Inter leads the sans stack instead — plus the four rules marked below.
       * ========================================================================== */

      :root {
        --bg:        #FAF7F2;
        --bg-tint:   #F2EDE4;
        --ink:       #14110F;
        --ink-soft:  #4A4540;
        --ink-mute:  #8A827A;
        --rule:      #D9D2C7;
        --accent:    #C8442B;
        --accent-deep:#9E3320;

        --serif: "Fraunces", "Source Serif 4", Georgia, "Times New Roman", serif;
        --sans: "Inter", "Helvetica Neue", Arial, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;

        --maxw: 1240px;
        --gutter: clamp(20px, 4vw, 56px);
        --rhythm: clamp(1.6rem, 0.4rem + 3vw, 2.4rem);
      }

      /* ---- reset ------------------------------------------------------------- */
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 16.5px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      img, svg { display: block; max-width: 100%; }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; }

      .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--gutter); }

      /* ---- type -------------------------------------------------------------- */
      .display, .serif { font-family: var(--serif); font-weight: 400; letter-spacing: -0.01em; }
      .eyebrow {
        font-family: var(--sans);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--accent);
        font-weight: 600;
      }
      h1, h2, h3, h4 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.015em; line-height: 1.04; }
      h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); }
      h2 { font-size: clamp(1.9rem, 3.6vw, 2.9rem); }
      h3 { font-size: clamp(1.25rem, 1.6vw, 1.55rem); }
      p { margin: 0 0 1em; color: var(--ink-soft); }
      .lede { font-family: var(--serif); font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.4; color: var(--ink); }

      /* ---- header ------------------------------------------------------------ */
      .site-header { position: sticky; top: 0; z-index: 50; background: rgba(250,247,242,0.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); }
      .header-row { display: flex; align-items: baseline; gap: 1.5rem; padding: 1rem 0; }
      .brand { display: flex; align-items: baseline; gap: 0.55rem; flex: 0 0 auto; }
      .brand-mark { font-family: var(--serif); font-size: 1.3rem; font-weight: 500; letter-spacing: -0.02em; }
      .brand-edition { font-family: var(--mono); font-size: 0.68rem; color: var(--ink-mute); letter-spacing: 0.05em; }
      .site-nav { display: flex; gap: 1.6rem; margin-left: auto; }
      .site-nav a { font-size: 0.92rem; color: var(--ink-soft); position: relative; padding-bottom: 2px; }
      .site-nav a:hover { color: var(--ink); }
      .site-nav a.is-active { color: var(--ink); }
      .site-nav a.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px; background: var(--accent); }
      .header-cta { font-size: 0.85rem; font-weight: 600; color: var(--bg); background: var(--ink); padding: 0.5rem 0.95rem; border-radius: 999px; }
      .header-cta:hover { background: var(--accent); }

      /* ---- footer ------------------------------------------------------------ */
      .site-footer { margin-top: 6rem; border-top: 1px solid var(--rule); background: var(--bg-tint); }
      .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.4fr; gap: 2.5rem; padding-top: 3rem; padding-bottom: 2rem; }
      .footer-brand .brand-mark { font-family: var(--serif); font-size: 1.5rem; }
      .footer-brand p { font-family: var(--serif); font-style: italic; max-width: 26ch; }
      .footer-col h4 { font-family: var(--sans); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-mute); margin: 0 0 0.9rem; font-weight: 600; }
      .footer-col a { display: block; font-size: 0.95rem; color: var(--ink-soft); padding: 0.18rem 0; }
      .footer-col a:hover { color: var(--accent); }
      .footer-meta p { font-size: 0.9rem; }
      /* The bottom padding clears the fixed Studio button, which would otherwise sit on the credit. */
      .footer-base { display: flex; justify-content: space-between; padding: 1.2rem 0 3.5rem; border-top: 1px solid var(--rule); font-size: 0.8rem; color: var(--ink-mute); }

      /* ---- hero -------------------------------------------------------------- */
      .hero { padding: clamp(3rem, 7vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--rule); }
      .hero-eyebrow { margin-bottom: 1.2rem; }
      .hero h1 { max-width: 16ch; margin: 0 0 1.4rem; }
      .hero .lede { max-width: 52ch; margin-bottom: 2rem; }
      .hero-meta { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; font-family: var(--mono); font-size: 0.82rem; color: var(--ink-soft); }
      .hero-meta span { display: inline-flex; align-items: center; gap: 0.5rem; }
      .hero-meta .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); display: inline-block; }

      /* ---- stat strip -------------------------------------------------------- */
      .stat-strip { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--rule); }
      .stat { padding: 2rem 0; border-right: 1px solid var(--rule); }
      .stat:last-child { border-right: none; }
      .stat .v { font-family: var(--serif); font-size: clamp(2rem, 3.5vw, 3rem); }
      .stat .l { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-mute); margin-top: 0.3rem; }

      /* ---- section frame ----------------------------------------------------- */
      .section { padding: clamp(3rem, 6vw, 5rem) 0; border-bottom: 1px solid var(--rule); }
      .section-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; gap: 2rem; flex-wrap: wrap; }
      .section-head .eyebrow { display: block; margin-bottom: 0.6rem; }
      .section-head a.more { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); border-bottom: 1px solid var(--accent); padding-bottom: 1px; }
      .section-head a.more:hover { color: var(--accent-deep); }

      /* ---- speaker grid ------------------------------------------------------ */
      .card-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.2rem, 2.5vw, 2.2rem); }
      .card { display: block; border: 0; }
      .avatar { display: block; border-radius: 2px; overflow: hidden; aspect-ratio: 1; line-height: 0; box-shadow: 0 1px 0 var(--rule); transition: transform 0.25s ease; }
      .card:hover .avatar { transform: translateY(-4px); }
      .card-body { padding-top: 0.9rem; }
      .card-name { font-size: 1.15rem; margin: 0 0 0.2rem; }
      .card-role { font-size: 0.86rem; color: var(--ink-mute); margin: 0; }

      /* ---- session rows ------------------------------------------------------ */
      .session-row { display: grid; grid-template-columns: 92px 84px 1fr 24px; gap: 1.2rem; align-items: baseline; padding: 1.15rem 0; border-top: 1px solid var(--rule); transition: background 0.18s ease; }
      .session-row:hover { background: var(--bg-tint); }
      .session-row:last-child { border-bottom: 1px solid var(--rule); }
      .session-time { display: flex; flex-direction: column; font-family: var(--mono); font-size: 0.8rem; color: var(--ink); }
      .session-time .t-end { color: var(--ink-mute); }
      .session-pill { justify-self: start; font-family: var(--mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: #fff; background: var(--c); padding: 0.18rem 0.5rem; border-radius: 2px; align-self: center; }
      .session-title { display: block; font-family: var(--serif); font-size: 1.2rem; color: var(--ink); margin-bottom: 0.25rem; }
      .session-meta { font-size: 0.85rem; color: var(--ink-mute); }
      .session-meta .session-speaker { color: var(--ink-soft); }
      .session-meta .session-speaker + .session-speaker::before { content: " & "; }
      .session-track { color: var(--ink-mute); }
      .session-arrow { color: var(--ink-mute); transition: transform 0.18s ease, color 0.18s ease; }
      .session-row:hover .session-arrow { color: var(--accent); transform: translateX(4px); }

      /* ---- schedule grid ----------------------------------------------------- */
      .schedule { display: grid; grid-template-columns: 140px 1fr; gap: 0; border-top: 1px solid var(--rule); }
      .schedule-time { font-family: var(--mono); font-size: 0.8rem; color: var(--ink-mute); padding: 1.1rem 1rem 1.1rem 0; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); text-align: right; }
      .schedule-slots { display: grid; grid-template-columns: repeat(var(--tracks, 6), 1fr); border-bottom: 1px solid var(--rule); }
      .schedule-slot { border-right: 1px solid var(--rule); padding: 0.9rem; min-height: 84px; }
      .schedule-slot:last-child { border-right: none; }
      .schedule-slot.is-empty { background: repeating-linear-gradient(135deg, transparent, transparent 6px, var(--bg-tint) 6px, var(--bg-tint) 7px); }
      .schedule-slot .slot-type { font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c); margin-bottom: 0.3rem; }
      .schedule-slot .slot-title { font-family: var(--serif); font-size: 0.98rem; line-height: 1.2; margin-bottom: 0.35rem; }
      .schedule-slot .slot-who { font-size: 0.76rem; color: var(--ink-mute); }
      .schedule-slot a { color: inherit; }
      .schedule-slot a:hover .slot-title { color: var(--accent); }
      .schedule-slot .slot-bar { height: 3px; background: var(--c); width: 28px; margin-bottom: 0.5rem; }

      .schedule-day-head { display: flex; justify-content: space-between; align-items: baseline; margin: 2.5rem 0 1rem; }
      .schedule-day-head h2 { margin: 0; }
      .schedule-day-head .date { font-family: var(--mono); font-size: 0.85rem; color: var(--ink-mute); }
      .track-legend { display: flex; flex-wrap: wrap; gap: 0.9rem 1.6rem; margin: 0.4rem 0 1rem; }
      .track-legend span { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; color: var(--ink-soft); }
      .track-legend i { width: 10px; height: 10px; border-radius: 2px; }
      .schedule-cols { display: grid; grid-template-columns: 140px repeat(var(--tracks, 6), 1fr); }
      .schedule-cols .col-head { border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 0.7rem 0.9rem; }
      .schedule-cols .col-head h4 { font-family: var(--sans); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.15rem; font-weight: 600; }
      .schedule-cols .col-head .room { font-size: 0.74rem; color: var(--ink-mute); }
      .schedule-cols .col-spacer { border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }

      /* ---- sponsors ---------------------------------------------------------- */
      .sponsor-tier { margin-bottom: 2.5rem; }
      .sponsor-tier-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.2rem; }
      .sponsor-tier-head h3 { margin: 0; text-transform: capitalize; }
      .sponsor-tier-head .tier-line { flex: 1; height: 1px; background: var(--rule); }
      .sponsor-grid { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
      .sponsor-grid.tier-platinum { grid-template-columns: repeat(2, 1fr); }
      .sponsor-grid.tier-gold { grid-template-columns: repeat(3, 1fr); }
      .sponsor-grid.tier-silver { grid-template-columns: repeat(4, 1fr); }
      .sponsor-grid.tier-partner { grid-template-columns: repeat(4, 1fr); }
      .sponsor-card { background: var(--bg); padding: 1.8rem; display: flex; flex-direction: column; gap: 0.8rem; transition: background 0.18s ease; }
      .sponsor-card:hover { background: var(--bg-tint); }
      .sponsor-mark { font-family: var(--serif); font-size: 1.4rem; font-weight: 500; letter-spacing: -0.02em; padding: 0.3rem 0.7rem; color: #fff; background: var(--mark); align-self: flex-start; border-radius: 2px; }
      .sponsor-blurb { font-size: 0.86rem; color: var(--ink-mute); margin: 0; }
      .sponsor-card .sponsor-link { font-family: var(--mono); font-size: 0.74rem; color: var(--accent); margin-top: auto; }

      /* ---- detail pages ------------------------------------------------------ */
      .detail-head { padding: clamp(2.5rem, 5vw, 4rem) 0 2rem; border-bottom: 1px solid var(--rule); }
      .back-link { font-family: var(--mono); font-size: 0.8rem; color: var(--ink-mute); display: inline-flex; gap: 0.4rem; margin-bottom: 1.5rem; }
      .back-link:hover { color: var(--accent); }
      .detail-grid { display: grid; grid-template-columns: 1fr 320px; gap: 3rem; align-items: start; }
      .detail-main h1 { margin: 0 0 1.2rem; }
      .detail-meta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2rem; }
      .chip { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.3rem 0.7rem; border: 1px solid var(--rule); border-radius: 2px; color: var(--ink-soft); }
      .chip.accent { color: #fff; background: var(--accent); border-color: var(--accent); }
      .detail-prose { font-size: 1.12rem; line-height: 1.6; max-width: 62ch; }
      .detail-prose p { color: var(--ink); margin-bottom: 1.1em; }
      .detail-aside { border-left: 1px solid var(--rule); padding-left: 2rem; }
      .detail-aside h4 { font-family: var(--sans); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-mute); margin: 0 0 1rem; font-weight: 600; }
      .kv { display: flex; justify-content: space-between; padding: 0.55rem 0; border-bottom: 1px solid var(--rule); font-size: 0.9rem; }
      .kv .k { color: var(--ink-mute); font-family: var(--mono); font-size: 0.78rem; }
      .kv .v { color: var(--ink); text-align: right; }

      /* speaker detail */
      .speaker-detail-grid { display: grid; grid-template-columns: 280px 1fr; gap: 3rem; align-items: start; }
      .speaker-aside .avatar { width: 280px !important; height: 280px !important; }
      .pronoun { font-family: var(--mono); font-size: 0.78rem; color: var(--ink-mute); margin: 0.4rem 0 1.2rem; }

      /* ---- venue ------------------------------------------------------------- */
      .venue-hero { padding: clamp(2.5rem,5vw,4rem) 0; border-bottom: 1px solid var(--rule); }
      .venue-map { aspect-ratio: 16/7; background: var(--bg-tint); border: 1px solid var(--rule); position: relative; overflow: hidden; margin-top: 2rem; }
      .venue-map svg { width: 100%; height: 100%; }
      .travel-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; border-top: 1px solid var(--rule); }
      .travel-item { padding: 1.8rem 0; border-bottom: 1px solid var(--rule); border-right: 1px solid var(--rule); padding-right: 2rem; }
      .travel-item:nth-child(2n) { border-right: none; }
      .travel-item h3 { font-size: 1.3rem; margin: 0 0 0.5rem; }
      .travel-item .mode { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 0.5rem; }

      /* tickets */
      .tickets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
      .ticket { border: 1px solid var(--rule); padding: 2rem; display: flex; flex-direction: column; background: var(--bg); }
      .ticket.is-featured { border-color: var(--ink); background: var(--ink); color: var(--bg); }
      .ticket .t-name { font-family: var(--mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.14em; }
      .ticket .t-price { font-family: var(--serif); font-size: 2.6rem; margin: 0.5rem 0 0.3rem; }
      .ticket .t-note { font-size: 0.86rem; color: var(--ink-mute); margin: 0 0 1.4rem; }
      .ticket.is-featured .t-note { color: rgba(250,247,242,0.7); }
      .ticket ul { list-style: none; margin: 0 0 1.6rem; padding: 0; }
      .ticket li { font-size: 0.92rem; padding: 0.35rem 0; display: flex; gap: 0.6rem; }
      .ticket li::before { content: "+"; color: var(--accent); font-family: var(--mono); }
      .ticket.is-featured li::before { color: var(--bg); }
      .ticket .t-cta { margin-top: auto; font-family: var(--mono); font-size: 0.82rem; padding: 0.7rem; text-align: center; border: 1px solid currentColor; }
      .ticket.is-featured .t-cta { background: var(--accent); border-color: var(--accent); color: #fff; }

      /* ---- generic helpers --------------------------------------------------- */
      .tag-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tag { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-soft); background: var(--bg-tint); padding: 0.25rem 0.6rem; border-radius: 2px; }
      .filter-bar { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.5rem; }
      .filter-bar button, .filter-bar a { font-family: var(--mono); font-size: 0.8rem; padding: 0.4rem 0.9rem; border: 1px solid var(--rule); background: var(--bg); color: var(--ink-soft); border-radius: 999px; cursor: pointer; }
      .filter-bar button:hover, .filter-bar a:hover { border-color: var(--ink); color: var(--ink); }
      .filter-bar button.is-active, .filter-bar a.is-active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
      .empty-note { padding: 2rem 0; color: var(--ink-mute); font-style: italic; }
      /* The empty notes link to Studio; muted italic alone gave an invisible link nothing to click on. */
      .empty-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
      .section-noborder { border-bottom: none; }

      /* ---- port additions -------------------------------------------------- */
      img.avatar { object-fit: cover; }
      .sponsor-mark-img { align-self: flex-start; max-height: 84px; width: auto; }
      .session-day-title { font-family: var(--mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-mute); margin: 2.2rem 0 0.6rem; }
      .studio { position: fixed; right: 16px; bottom: 16px; font: 13px "Inter", system-ui, sans-serif; background: var(--accent); color: #fff; padding: 8px 12px; border-radius: 999px; opacity: .9 }

      /* ---- responsive -------------------------------------------------------- */
      @media (max-width: 1000px) {
        .card-grid { grid-template-columns: repeat(3, 1fr); }
        .stat-strip { grid-template-columns: repeat(2, 1fr); }
        .stat:nth-child(2) { border-right: none; }
        .stat:nth-child(1), .stat:nth-child(2) { border-bottom: 1px solid var(--rule); }
        .footer-grid { grid-template-columns: 1fr 1fr; }
        .detail-grid, .speaker-detail-grid { grid-template-columns: 1fr; gap: 2rem; }
        .detail-aside, .speaker-aside { border-left: none; border-top: 1px solid var(--rule); padding-left: 0; padding-top: 1.5rem; }
        .schedule, .schedule-cols { grid-template-columns: 70px repeat(var(--tracks,6), 1fr); font-size: 0.8rem; }
        .schedule-slot { padding: 0.5rem 0.4rem; min-height: 70px; }
        .schedule-slot .slot-title { font-size: 0.82rem; }
      }
      @media (max-width: 700px) {
        .site-nav { display: none; }
        .header-cta { margin-left: auto; }
        .card-grid { grid-template-columns: repeat(2, 1fr); }
        .footer-grid { grid-template-columns: 1fr; }
        .tickets { grid-template-columns: 1fr; }
        .travel-grid { grid-template-columns: 1fr; }
        .travel-item { border-right: none; padding-right: 0; }
        .session-row { grid-template-columns: 70px 1fr; row-gap: 0.4rem; }
        .session-pill, .session-arrow { grid-column: 2; }
        .schedule, .schedule-cols { grid-template-columns: 50px repeat(var(--tracks,6), minmax(44px, 1fr)); }
        .schedule-slot .slot-who { display: none; }
        .schedule-slot .slot-title { font-size: 0.74rem; }
        .col-head .room, .schedule-time { font-size: 0.62rem; }
        .sponsor-grid.tier-platinum, .sponsor-grid.tier-gold,
        .sponsor-grid.tier-silver, .sponsor-grid.tier-partner { grid-template-columns: 1fr 1fr; }
      }

      /* ---- print niceties ---------------------------------------------------- */
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="site-header"><div class="wrap header-row">
      <a class="brand" href="/">
        <span class="brand-mark">{siteName}</span>
        {ev?.edition && <span class="brand-edition">{ev.edition}</span>}
      </a>
      <nav class="site-nav">
        {nav.map(item => <a href={item.href} class={current === item.href || (item.href !== '/' && current.startsWith(`${item.href}/`)) ? 'is-active' : ''}>{item.label}</a>)}
      </nav>
      {ev?.ctaLabel && ev?.ctaHref && <a class="header-cta" href={ev.ctaHref}>{ev.ctaLabel}</a>}
    </div></header>

    <main><slot /></main>

    {ev && (
      <footer class="site-footer">
        <div class="wrap footer-grid">
          <div class="footer-brand">
            <span class="brand-mark">{ev.name}</span>
            {ev.tagline && <p>{ev.tagline}</p>}
          </div>
          <div class="footer-col">
            <h4>Programme</h4>
            <a href="/schedule">Schedule</a>
            <a href="/speakers">Speakers</a>
            <a href="/sessions">Sessions</a>
          </div>
          <div class="footer-col">
            <h4>Visit</h4>
            <a href="/venue">Venue &amp; travel</a>
            <a href="/sponsors">Sponsors</a>
            {ev.ctaHref && <a href={ev.ctaHref}>Get a pass</a>}
          </div>
          <div class="footer-col footer-meta">
            <h4>{ev.city}</h4>
            {ev.venue && <p>{ev.venue}</p>}
            {(ev.startDate || ev.endDate) && <p>{formatDateRange(ev.startDate, ev.endDate)}</p>}
          </div>
        </div>
        <div class="wrap footer-base">
          <span>© {[ev.edition, ev.name].filter(Boolean).join(' ')}. Every word here is editable in Studio.</span>
          <span class="footer-credit">A Trokky template</span>
        </div>
      </footer>
    )}
    <a class="studio" href="/studio">Edit in Studio →</a>
  </body>
</html>